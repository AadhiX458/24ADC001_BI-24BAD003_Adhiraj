      <column caption='Case Fatality Rate' datatype='real' name='[Calculation_1289755095896065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_deaths]) / SUM([total_cases]) * 100' />
      </column>
      <column caption='Vaccination Rate' datatype='real' name='[Calculation_1289755096162306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([people_vaccinated]) / SUM([population]) * 100' />
      </column>
      <column caption='Daily Growth Rate' datatype='real' name='[Calculation_1289755096715267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([new_cases]) / SUM([total_cases]) * 100' />
      </column>
