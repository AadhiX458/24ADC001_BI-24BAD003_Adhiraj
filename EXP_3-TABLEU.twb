      <aliases enabled='yes' />
      <column caption='Order Priority clean' datatype='string' name='[Calculation_0514872467705861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF TRIM([Order Priority]) = &quot;medium&quot; THEN&#13;&#10;    &quot;Medium&quot;&#13;&#10;ELSE&#13;&#10;    TRIM([Order Priority])&#13;&#10;END' />
      </column>
      <column caption='Sales Status' datatype='string' name='[Calculation_0514872471027718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt; 1000000 THEN&#13;&#10;&quot;Outlier&quot;&#13;&#10;ELSE&#13;&#10;&quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_0514872471191559]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; -100000 THEN&#13;&#10;&quot;Outlier&quot;&#13;&#10;ELSE&#13;&#10;&quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='Country clean' datatype='string' name='[Calculation_1738079137972224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE UPPER(TRIM(IFNULL([Country], &quot;&quot;)))&#13;&#10;    WHEN &quot;&quot; THEN &quot;Unknown&quot;&#13;&#10;    WHEN &quot;USA&quot; THEN &quot;United States&quot;&#13;&#10;    WHEN &quot;U.S.A&quot; THEN &quot;United States&quot;&#13;&#10;    WHEN &quot;US&quot; THEN &quot;United States&quot;&#13;&#10;    ELSE TRIM([Country])&#13;&#10;END' />
      </column>
      <column caption='Product clean' datatype='string' name='[Calculation_1738079139155969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Product Name], &quot;Unknown&quot;)' />
      </column>
      <column caption='Sales clean' datatype='real' name='[Calculation_1738079139344386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Sales], 0)' />
      </column>
      <column caption='Profit clean' datatype='real' name='[Calculation_1738079139954691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Profit], 0)' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
